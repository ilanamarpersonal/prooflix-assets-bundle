__pycache__/
*.pyc
.DS_Store

# The data lake: source files, Delta tables and streaming checkpoints. They can be
# gigabytes, far over GitHub's 100 MB file limit, and the pipelines rebuild the
# tables, so the whole folder stays on disk, outside git.
/data/
.prooflix/trash/

# A workspace's data/ and source/ are links Prooflix makes to the data lake and the
# source data folder (paths on this machine), so they stay out of git.
workspace/*/data
workspace/*/source
# Prooflix's local state for the workspace: run history and folder settings
workspace/*/.prooflix/
